#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

// default: 600
#define ZMK_POINTING_DEFAULT_MOVE_VAL 600
// default: 10
#define ZMK_POINTING_DEFAULT_SCRL_VAL 10
#include <dt-bindings/zmk/pointing.h>

// layers
#define LAY_QWERTY 0
#define LAY_LOWER  1
#define LAY_ARROWS 2
#define LAY_ARROW2 3
#define LAY_MOUSE  4
#define LAY_MAGIC  5

/ {
    behaviors {
        // For the "layer" key, it'd nice to be able to use it as either a shift or a toggle.
        // Configure it as a tap dance, so the first tap (or hold) is a &mo and the second tap is a &to
        layer_td: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER_TAP_DANCE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo LAY_LOWER>, <&to LAY_LOWER>;
        };

        magic: magic_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MAGIC_HOLD_TAP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&rgb_ug_status_macro>;
        };
    };

    macros {
        rgb_ug_status_macro: rgb_ug_status_macro_0 {
            label = "RGB_UG_STATUS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&rgb_ug RGB_STATUS>;
        };

        bt_0: bt_profile_macro_0 {
            label = "BT_0";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 0>;
        };

        bt_1: bt_profile_macro_1 {
            label = "BT_1";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 1>;
        };

        bt_2: bt_profile_macro_2 {
            label = "BT_2";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 2>;
        };

        bt_3: bt_profile_macro_3 {
            label = "BT_3";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {            //default       //default       //default       //default       //default       //default //default //default    | //default //default //default       //default      //default      //default       //default       //default  //default
                //C6L              //C5L           //C4L           //C3L           //C2L           //C1L           //T1L     //T2L     //T3L        | //T3R     //T2R     //T1R           //C1R          //C2R          //C3R           //C4R           //C5R      //C6R
            bindings = <
                &kp F1             &kp F2          &kp F3          &kp F4          &kp F5                                                                                                                &kp F6         &kp F7          &kp F8          &kp F9     &kp F10
                &none              &kp N1          &kp N2          &kp N3          &kp N4          &kp N5                                                                                 &kp N6         &kp N7         &kp N8          &kp N9          &kp N0     &none
                &kp TAB            &kp TAB         &kp W           &kp E           &kp R           &kp T                                                                                  &kp Y          &kp U          &kp I           &kp O           &none      &kp MINUS
                &kp ESC            &kp A           &kp S           &kp D           &kp F           &kp G                                                                                  &kp H          &kp J          &kp K           &kp L           &kp SEMI   &kp P
                &kp GRAVE          &kp Q           &kp X           &kp C           &kp V           &kp B           &kp LSHFT &kp LCTRL &kp LGUI       &kp RCTRL &kp RSHFT &mo LAY_LOWER   &kp N          &kp M          &kp COMMA       &kp DOT         &kp FSLH   &kp SQT 
                &magic LAY_MAGIC 0 &kp Z           &kp EQUAL       &kp LEFT        &kp RIGHT                       &kp BSPC  &kp DEL   &kp LALT       &kp RALT  &kp RET   &kp SPACE                      &kp DOWN       &kp UP          &kp LBKT        &kp RBKT   &kp BSLH
            >;
                //C6L              //C5L           //C4L           //C3L           //C2L           //C1L           //T1L     //T2L     //T3L        | //T3R     //T2R     //T1R           //C1R          //C2R          //C3R           //C4R           //C5R      //C6R
        };                         //default       //default       //default       //default       //default       //default //default //default    | //default //default //default       //default      //default      //default       //default       //default  //default
        lower_layer {              //lower         //lower         //lower         //lower         //lower         //lower   //lower   //lower      | //lower   //lower   //lower         //lower        //lower        //lower         //lower         //lower    //lower
                //C6L              //C5L           //C4L           //C3L           //C2L           //C1L           //T1L     //T2L     //T3L        | //T3R     //T2R     //T1R           //C1R          //C2R          //C3R           //C4R           //C5R      //C6R
            bindings = <
                &none              &none           &none           &none           &none                                                                                                                 &kp C_MUTE     &kp C_VOL_DN    &kp C_VOL_UP    &none      &kp PAUSE_BREAK
                &none              &none           &none           &none           &kp C_BRI_UP    &kp PG_UP                                                                              &kp LANG1      &kp C_PP       &kp C_NEXT      &kp C_PREV      &kp C_STOP &none
                &trans             &none           &none           &kp UP          &kp C_BRI_DN    &kp PG_DN                                                                              &kp LANG2      &kp KP_N7      &kp KP_N8       &kp KP_N9       &none      &none
                &trans             &none           &kp LEFT        &kp DOWN        &kp RIGHT       &kp HOME                                                                               &kp LANG3      &kp KP_N4      &kp KP_N5       &kp KP_N6       &kp MINUS  &none
                &trans             &kp K_CMENU     &none           &kp F11         &kp F12         &kp END         &trans    &trans    &trans         &trans    &trans    &to LAY_QWERTY  &kp LANG4      &kp KP_N1      &kp KP_N2       &kp KP_N3       &none      &none
                &trans             &none           &kp INS         &kp F11         &kp F12                         &trans    &trans    &trans         &trans    &trans    &trans                         &kp KP_N0      &kp KP_N0       &kp LPAR        &kp RPAR   &kp PRINTSCREEN
            >;
                //C6L              //C5L           //C4L           //C3L           //C2L           //C1L           //T1L     //T2L     //T3L        | //T3R     //T2R     //T1R           //C1R          //C2R          //C3R           //C4R           //C5R      //C6R
        };                         //lower         //lower         //lower         //lower         //lower         //lower   //lower   //lower      | //lower   //lower   //lower         //lower        //lower        //lower         //lower         //lower    //lower
        arrows_layer {             //arrows        //arrows        //arrows        //arrows        //arrows        //arrows  //arrows  //arrows     | //arrows  //arrows  //arrows        //arrows       //arrows       //arrows        //arrows        //arrows   //arrows
                //C6L              //C5L           //C4L           //C3L           //C2L           //C1L           //T1L     //T2L     //T3L        | //T3R     //T2R     //T1R           //C1R          //C2R          //C3R           //C4R           //C5R      //C6R
            bindings = <
                &none              &none           &none           &kt W           &none                                                                                                                 &none          &none           &none           &none      &none
                &none              &kp N1          &kp N2          &kp N3          &kp N4          &kp N5                                                                                 &none          &none          &none           &none           &none      &none
                &kp TAB            &kp TAB         &kp T           &kp W           &kp E           &kp R                                                                                  &none          &kp I          &kp UP          &none           &none      &none
                &kp ESC            &kp Z           &kp A           &kp S           &kp D           &kp F                                                                                  &none          &kp LEFT       &kp DOWN        &kp RIGHT       &none      &none
                &none              &kp Q           &kp X           &kp C           &kp V           &kp G           &kp LSHFT &kp LCTRL &mo LAY_ARROW2 &none     &kp RCTRL &kp RSHFT       &none          &kp M          &kp J           &kp L           &none      &none
                &magic LAY_MAGIC 0 &kp Y           &kp J           &kp M           &kp I                           &kp SPACE &kp RET   &kp LALT       &kp RALT  &kp RET   &kp SPACE                      &none          &none           &none           &none      &none
            >;
                //C6L              //C5L           //C4L           //C3L           //C2L           //C1L           //T1L     //T2L     //T3L        | //T3R     //T2R     //T1R           //C1R          //C2R          //C3R           //C4R           //C5R      //C6R
        };                         //arrows        //arrows        //arrows        //arrows        //arrows        //arrows  //arrows  //arrows     | //arrows  //arrows  //arrows        //arrows       //arrows       //arrows        //arrows        //arrows   //arrows
        arrows2_layer {            //arrows2       //arrows2       //arrows2       //arrows2       //arrows2       //arrows2 //arrows2 //arrows2    | //arrows2 //arrows2 //arrows2       //arrows2      //arrows2      //arrows2       //arrows2       //arrows2  //arrows2
                //C6L              //C5L           //C4L           //C3L           //C2L           //C1L           //T1L     //T2L     //T3L        | //T3R     //T2R     //T1R           //C1R          //C2R          //C3R           //C4R           //C5R      //C6R
            bindings = <
                &none              &none           &none           &kt UP          &none                                                                                                                 &none          &none           &none           &none      &none
                &none              &kp N6          &kp N7          &kp N8          &kp N9          &kp N0                                                                                 &none          &none          &none           &none           &none      &none
                &none              &none           &none           &kp UP          &kt E           &kt R                                                                                  &none          &none          &none           &none           &none      &none
                &kt TAB            &kt Z           &kp LEFT        &kp DOWN        &kp RIGHT       &kt F                                                                                  &none          &none          &none           &none           &none      &none
                &none              &kt Q           &kt X           &kt C           &kt V           &kt G           &none     &none     &none          &none     &none     &to LAY_QWERTY  &none          &none          &none           &none           &none      &none
                &none              &kt Y           &kt J           &kt M           &kt I                           &none     &none     &none          &none     &none     &none                          &none          &none           &none           &none      &none
            >;
                //C6L              //C5L           //C4L           //C3L           //C2L           //C1L           //T1L     //T2L     //T3L        | //T3R     //T2R     //T1R           //C1R          //C2R          //C3R           //C4R           //C5R      //C6R
        };                         //arrows2       //arrows2       //arrows2       //arrows2       //arrows2       //arrows2 //arrows2 //arrows2    | //arrows2 //arrows2 //arrows2       //arrows2      //arrows2      //arrows2       //arrows2       //arrows2  //arrows2
        mouse_layer {              //mouse         //mouse         //mouse         //mouse         //mouse         //mouse   //mouse   //mouse      | //mouse   //mouse   //mouse         //mouse        //mouse        //mouse         //mouse         //mouse    //mouse
                //C6L              //C5L           //C4L           //C3L           //C2L           //C1L           //T1L     //T2L     //T3L        | //T3R     //T2R     //T1R           //C1R          //C2R          //C3R           //C4R           //C5R      //C6R
            bindings = <
                &none              &none           &none           &none           &none                                                                                                                 &none          &none           &none           &none      &none
                &none              &none           &none           &none           &none           &none                                                                                  &none          &none          &none           &none           &none      &none
                &none              &none           &none           &msc SCRL_DOWN  &msc SCRL_UP    &none                                                                                  &none          &none          &none           &none           &none      &none
                &to LAY_QWERTY     &none           &mkp RCLK       &mkp MCLK       &mkp LCLK       &mkp MB5                                                                               &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP    &mmv MOVE_RIGHT &none      &none
                &none              &none           &none           &none           &none           &mkp MB4        &kp LSHFT &kp LCTRL &none          &none     &mkp MB4  &mkp MB5        &none          &msc SCRL_LEFT &msc SCRL_RIGHT &none           &none      &none
                &to LAY_QWERTY     &none           &none           &msc SCRL_LEFT  &msc SCRL_RIGHT                 &none     &none     &kp LALT       &mkp MCLK &mkp RCLK &mkp LCLK                      &msc SCRL_DOWN &msc SCRL_UP    &none           &none      &none
            >;
                //C6L              //C5L           //C4L           //C3L           //C2L           //C1L           //T1L     //T2L     //T3L        | //T3R     //T2R     //T1R           //C1R          //C2R          //C3R           //C4R           //C5R      //C6R
        };                         //mouse         //mouse         //mouse         //mouse         //mouse         //mouse   //mouse   //mouse      | //mouse   //mouse   //mouse         //mouse        //mouse        //mouse         //mouse         //mouse    //mouse
        magic_layer {              //magic         //magic         //magic         //magic         //magic         //magic   //magic   //magic      | //magic   //magic   //magic         //magic        //magic        //magic         //magic         //magic    //magic
                //C6L              //C5L           //C4L           //C3L           //C2L           //C1L           //T1L     //T2L     //T3L        | //T3R     //T2R     //T1R           //C1R          //C2R          //C3R           //C4R           //C5R      //C6R
            bindings = <
                &bt BT_CLR         &none           &kp CAPSLOCK    &kp KP_NUMLOCK  &kp SCROLLLOCK                                                                                                        &none          &none           &none           &none      &bt BT_CLR_ALL
                &sys_reset         &none           &none           &none           &none           &none                                                                                  &none          &none          &none           &none           &none      &sys_reset
                &none              &rgb_ug RGB_SPI &rgb_ug RGB_SAI &rgb_ug RGB_HUI &rgb_ug RGB_BRI &rgb_ug RGB_TOG                                                                        &none          &none          &none           &none           &none      &none
                &bootloader        &rgb_ug RGB_SPD &rgb_ug RGB_SAD &rgb_ug RGB_HUD &rgb_ug RGB_BRD &rgb_ug RGB_EFF                                                                        &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP    &mmv MOVE_RIGHT &none      &bootloader
                &to LAY_MOUSE      &none           &none           &none           &none           &none           &bt_2      &bt_3    &none          &none     &mkp MB4  &mkp MB5        &none          &msc SCRL_LEFT &msc SCRL_RIGHT &none           &none      &none
                &none              &to LAY_QWERTY  &none           &to LAY_LOWER   &to LAY_ARROWS                  &bt_0      &bt_1    &out OUT_USB   &mkp MCLK &mkp RCLK &mkp LCLK                      &msc SCRL_DOWN &msc SCRL_UP    &none           &none      &none
            >;
                //C6L              //C5L           //C4L           //C3L           //C2L           //C1L           //T1L     //T2L     //T3L        | //T3R     //T2R     //T1R           //C1R          //C2R          //C3R           //C4R           //C5R      //C6R
        };                         //magic         //magic         //magic         //magic         //magic         //magic   //magic   //magic      | //magic   //magic   //magic         //magic        //magic        //magic         //magic         //magic    //magic
//      empty_layer {              //empty         //empty         //empty         //empty         //empty         //empty   //empty   //empty      | //empty   //empty   //empty         //empty        //empty        //empty         //empty         //empty    //empty
//              //C6L              //C5L           //C4L           //C3L           //C2L           //C1L           //T1L     //T2L     //T3L        | //T3R     //T2R     //T1R           //C1R          //C2R          //C3R           //C4R           //C5R      //C6R
//          bindings = <
//              &none              &none           &none           &none           &none                                                                                                                 &none          &none           &none           &none      &none
//              &none              &none           &none           &none           &none           &none                                                                                  &none          &none          &none           &none           &none      &none
//              &none              &none           &none           &none           &none           &none                                                                                  &none          &none          &none           &none           &none      &none
//              &none              &none           &none           &none           &none           &none                                                                                  &none          &none          &none           &none           &none      &none
//              &none              &none           &none           &none           &none           &none           &none      &none    &none          &none     &none     &to LAY_QWERTY  &none          &none          &none           &none           &none      &none
//              &none              &none           &none           &none           &none                           &none      &none    &none          &none     &none     &none                          &none          &none           &none           &none      &none
//          >;
//              //C6L              //C5L           //C4L           //C3L           //C2L           //C1L           //T1L     //T2L     //T3L        | //T3R     //T2R     //T1R           //C1R          //C2R          //C3R           //C4R           //C5R      //C6R
//      };                         //empty         //empty         //empty         //empty         //empty         //empty   //empty   //empty      | //empty   //empty   //empty         //empty        //empty        //empty         //empty         //empty    //empty
    };
};
